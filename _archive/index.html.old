    {id:uid(),date:dayAgo(12),source:'Client B',payType:'hourly',quantity:18,rate:28,hours:18,amount:504,account:'Holding',notes:'Rate rise'},
    {id:uid(),date:dayAgo(5), source:'Employer',payType:'weekly',quantity:1,rate:640,hours:38,amount:640,account:'Holding',notes:''}
  ];
  s.expenses = [
    {id:uid(),date:dayAgo(60),category:'Rent/Mortgage',description:'Monthly rent',amount:850,account:'Operating',essential:true},
    {id:uid(),date:dayAgo(58),category:'Groceries',description:'Weekly shop',amount:78,account:'Operating',essential:true},
    {id:uid(),date:dayAgo(52),category:'Utilities',description:'Electricity + gas',amount:112,account:'Operating',essential:true},
    {id:uid(),date:dayAgo(45),category:'Transport',description:'Train pass',amount:95,account:'Operating',essential:true},
    {id:uid(),date:dayAgo(38),category:'Dining',description:'Dinner out',amount:42,account:'Operating',essential:false},
    {id:uid(),date:dayAgo(30),category:'Rent/Mortgage',description:'Monthly rent',amount:850,account:'Operating',essential:true},
    {id:uid(),date:dayAgo(28),category:'Groceries',description:'Weekly shop',amount:82,account:'Operating',essential:true},
    {id:uid(),date:dayAgo(22),category:'Subscriptions',description:'Streaming',amount:14,account:'Operating',essential:false},
    {id:uid(),date:dayAgo(15),category:'Insurance',description:'Car insurance',amount:48,account:'Operating',essential:true},
    {id:uid(),date:dayAgo(9), category:'Groceries',description:'Weekly shop',amount:74,account:'Operating',essential:true},
    {id:uid(),date:dayAgo(4), category:'Shopping',description:'New shoes',amount:65,account:'Operating',essential:false}
  ];
  s.transfers = [
    {id:uid(),date:dayAgo(58),from:'Holding',to:'Operating',amount:1400,notes:'Monthly paycheck'},
    {id:uid(),date:dayAgo(28),from:'Holding',to:'Operating',amount:1400,notes:'Monthly paycheck'},
    {id:uid(),date:dayAgo(2), from:'Holding',to:'Operating',amount:1400,notes:'Monthly paycheck'}
  ];
  return s;
}

/* ============================================================
   INIT
   ============================================================ */
function init(){
  const had = load();
  if(!had){ state=defaultState(); save(); }

  $$('.tab').forEach(t=>t.onclick=()=>setView(t.dataset.view));

  $('#btnQuickBackup').onclick = ()=>saveBackupFile();
  $('#btnSettings').onclick    = ()=>setView('data');

  window.addEventListener('beforeunload', e=>{
    if(!state.lastBackupAt && (state.incomes.length+state.expenses.length)>5){
      e.preventDefault(); e.returnValue='';
    }
  });

  render();

  if('serviceWorker' in navigator){
    navigator.serviceWorker.register('sw.js').catch(()=>{});
  }
}
document.addEventListener('DOMContentLoaded', init);
})();
</script>
</body>
</html>
