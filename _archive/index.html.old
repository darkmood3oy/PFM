  s.openingBalances = {Holding:1200,Operating:400,Savings:3000};
  s.incomes = [
    {id:uid(),date:dayAgo(62),source:'Client A',payType:'hourly',quantity:36,rate:25,hours:36,amount:900,account:'Holding',notes:'Design sprint'},
    {id:uid(),date:dayAgo(55),source:'Employer',payType:'weekly',quantity:1,rate:620,hours:38,amount:620,account:'Holding',notes:''},
